# Copy via scripts/init_production.py; keep the real env and secret directory out of Git.
PRODUCTION_PROJECT=stockinsight-production
APP_IMAGE=registry.example.invalid/stockinsight-app:COMMIT_SHA
PROXY_IMAGE=registry.example.invalid/stockinsight-proxy:COMMIT_SHA
OPS_IMAGE=registry.example.invalid/stockinsight-ops:COMMIT_SHA
PRODUCTION_SECRETS_DIR=/opt/stockinsight/secrets
PRODUCTION_CONFIG_DIR=/opt/stockinsight/config
DOMAIN=research.example.invalid
# For PUBLIC deployment, use the owner's ACME contact email here, not 'internal'.
TLS_ISSUER=owner@example.invalid
TLS_HOST=research.example.invalid
PROXY_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
CHECK_FRESHNESS=true
BACKUP_REMOTE=backup@backup.example.invalid:/srv/stockinsight
# Set true only after the owner confirms display rights for this data and audience.
DATA_USE_CONFIRMED=false
