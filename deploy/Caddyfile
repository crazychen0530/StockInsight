{
	admin off
	auto_https disable_redirects
}
http://{$DOMAIN:localhost} {
	redir https://{$DOMAIN:localhost}:{$HTTPS_REDIRECT_PORT:443}{uri} permanent
}
https://{$DOMAIN:localhost} {
	tls {$TLS_ISSUER:internal}
	encode zstd gzip
	request_body {
		max_size 16KB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'"
		-Server
	}
	log {
		output file /var/log/caddy/access.json {
			mode 0644
			roll_size 10MiB
			roll_keep 3
		}
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri delete
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				resp_headers delete
			}
		}
	}
	log_append invited_user {http.auth.user.id}
	route {
		import /run/secrets/invited_users
		@unsafe method POST PUT PATCH DELETE
		respond @unsafe "Read-only deployment" 403
		handle /api/* {
			reverse_proxy api:8000 {
				header_up -Authorization
				header_up -X-Admin-Token
			}
		}
		handle /docs* {
			respond 404
		}
		handle /openapi.json {
			respond 404
		}
		handle {
			root * /srv
			try_files {path} /index.html
			file_server
		}
	}
}
