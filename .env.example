# Safe local-development placeholders only. Copy to .env and choose a private password.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
WEB_PORT=5173
LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Shanghai

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=stockinsight
POSTGRES_USER=stockinsight
POSTGRES_PASSWORD=change-me-for-local-development

# Compose reads .env and injects PG* variables plus a password-free DATABASE_URL.
# Native Alembic commands still require explicit DATABASE_URL and PGPASSWORD.
# APP_ENV=test requires TEST_DATABASE_URL; never point tests at the development DB.
# TEST_DATABASE_URL=postgresql+psycopg:///example_migration_test
# Do not put production credentials or provider tokens in this example file.
MARKET_DATA_PROVIDER=akshare
MARKET_DATA_TIMEOUT_SECONDS=30
PRICE_ADJUSTMENT=none
DAILY_UPDATE_TIME=17:30
# Without SOURCE_POLICY_DIRECTORY, native CLI defaults to Eastmoney and Compose interface fallback defaults to Tencent.
# Compose now enables the shared web policy, which takes precedence (initially Eastmoney first).
# MARKET_DATA_DAILY_INTERFACE=stock_zh_a_hist_tx

# Generated by scripts/init_source_settings.py; never commit your real management token.
# LOCAL_ADMIN_TOKEN=
# Native CLI may opt into the same directory with SOURCE_POLICY_DIRECTORY.
